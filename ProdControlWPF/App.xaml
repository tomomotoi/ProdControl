<Application x:Class="ProdControlWPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ProdControlWPF.ViewModels"
             xmlns:views="clr-namespace:ProdControlWPF.Views"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type vm:MessageViewModel}">
                <views:MessageView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:NewBillViewModel}">
                <views:NewBillView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:SearchBillViewModel}">
                <views:SearchBillView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:NewKnittingInvoiceViewModel}">
                <views:NewKnittingInvoiceView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:KnittingSearchInvoiceViewModel}">
                <views:KnittingSearchInvoiceView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:WorkOrdersViewModel}">
                <views:WorkOrdersView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:NewArticulViewModel}">
                <views:NewArticulView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:OperationViewModel}">
                <views:OperationView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:EmployeesViewModel}">
                <views:EmployeesView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:CoefficientsViewModel}">
                <views:CoefficientsView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:DetailsViewModel}">
                <views:DetailsView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:MachinesViewModel}">
                <views:MachinesView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:RoutingViewModel}">
                <views:RoutingView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:KnittingRoutingViewModel}">
                <views:KnittingRoutingView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:TariffsCheckViewModel}">
                <views:TariffsCheckView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:CalculationViewModel}">
                <views:CalculationView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:ReportViewerViewModel}">
                <views:ReportViewerView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
