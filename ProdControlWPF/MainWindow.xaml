<Window x:Class="ProdControlWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Главное окно"
        Width="888"
        Height="500"
        MinWidth="700"
        MinHeight="400"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Накладные">
                <MenuItem Header="Новая (Швейный цех)"
                          Command="{Binding OpenScreenCommand}"
                          CommandParameter="Новая (Швейный цех)" />
                <MenuItem Header="Найти (Швейный цех)"
                          Command="{Binding OpenScreenCommand}"
                          CommandParameter="Найти (Швейный цех)" />
                <MenuItem Header="Новая (Вязальный цех)"
                          Command="{Binding OpenScreenCommand}"
                          CommandParameter="Новая (Вязальный цех)" />
                <MenuItem Header="Найти (Вязальный цех)"
                          Command="{Binding OpenScreenCommand}"
                          CommandParameter="Найти (Вязальный цех)" />
            </MenuItem>

            <MenuItem Header="Основные данные">
                <MenuItem Header="Артикул"
                          Command="{Binding OpenScreenCommand}"
                          CommandParameter="Артикул" />
                <MenuItem Header="Операция"
                          Command="{Binding OpenScreenCommand}"
                          CommandParameter="Операция" />
                <MenuItem Header="Тех.карта"
                          Command="{Binding OpenScreenCommand}"
                          CommandParameter="Тех.карта" />
                <MenuItem Header="Тех.карта (Вязание)"
                          Command="{Binding OpenScreenCommand}"
                          CommandParameter="Тех.карта (Вязание)" />
                <MenuItem Header="Проверка расценок работ"
                          Command="{Binding OpenScreenCommand}"
                          CommandParameter="Проверка расценок работ" />
                <MenuItem Header="Сотрудники"
                          Command="{Binding OpenScreenCommand}"
                          CommandParameter="Сотрудники" />
                <MenuItem Header="Коэффициенты доп. затрат"
                          Command="{Binding OpenScreenCommand}"
                          CommandParameter="Коэффициенты доп. затрат" />
                <MenuItem Header="Детали изделий"
                          Command="{Binding OpenScreenCommand}"
                          CommandParameter="Детали изделий" />
                <MenuItem Header="Оборудование"
                          Command="{Binding OpenScreenCommand}"
                          CommandParameter="Оборудование" />
                <MenuItem Header="Наряды">
                    <MenuItem Header="Действующие"
                              Command="{Binding OpenScreenCommand}"
                              CommandParameter="Наряды → Действующие" />
                    <MenuItem Header="Выполненные"
                              Command="{Binding OpenScreenCommand}"
                              CommandParameter="Наряды → Выполненные" />
                </MenuItem>
            </MenuItem>

            <MenuItem Header="Отчеты">
                <MenuItem Header="Норма выработки"
                          Command="{Binding OpenScreenCommand}"
                          CommandParameter="Норма выработки" />
                <MenuItem Header="Отчет по сотруднику"
                          Command="{Binding OpenScreenCommand}"
                          CommandParameter="Отчет по сотруднику" />
            </MenuItem>

            <MenuItem Header="Утилиты">
                <MenuItem Header="Очистка таблицы OperationLog"
                          Command="{Binding ClearOperationLogCommand}" />
                <MenuItem Header="Восстановить БД из архива">
                    <MenuItem Header="Выбрать файл..."
                              Command="{Binding RestoreFromFileCommand}" />
                    <MenuItem Header="Авто"
                              Command="{Binding RestoreLatestCommand}" />
                </MenuItem>
                <MenuItem Header="Создать копию БД"
                          Command="{Binding BackupDatabaseCommand}" />
                <MenuItem Header="Очистить архив копий БД"
                          Command="{Binding ClearArchiveCommand}" />
            </MenuItem>

            <MenuItem Header="Выход" Command="{Binding ExitCommand}" />
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
        </StatusBar>

        <ContentControl x:Name="ContentHost" Margin="16" />
    </DockPanel>
</Window>
