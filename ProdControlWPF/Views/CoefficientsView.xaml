<UserControl x:Class="ProdControlWPF.Views.CoefficientsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="420"
             d:DesignWidth="640">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource AppSurfaceBrush}"
                BorderBrush="{StaticResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Новый коэффициент:"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <TextBox Grid.Column="1"
                         Text="{Binding NewCoefficientValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Width="90" />
                <Button Grid.Column="2"
                        Content="Добавить"
                        Command="{Binding AddCoefficientCommand}"
                        IsEnabled="{Binding IsEditMode}"
                        Width="110"
                        Margin="12,0,0,0" />
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="{StaticResource AppSurfaceBrush}"
                BorderBrush="{StaticResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                Margin="0,12,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Коэффициенты:"
                           VerticalAlignment="Center" />
                <Button Grid.Row="0"
                        Content="Удалить"
                        Command="{Binding DeleteCoefficientCommand}"
                        IsEnabled="{Binding IsEditMode}"
                        HorizontalAlignment="Right"
                        Width="110" />

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Coefficients}"
                         SelectedItem="{Binding SelectedCoefficient, Mode=TwoWay}"
                         DisplayMemberPath="Value"
                         Margin="0,8,0,0"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="AutomationProperties.Name" Value="{Binding Value}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>

        <CheckBox Grid.Row="2"
                  Content="Режим редактирования"
                  IsChecked="{Binding IsEditMode, Mode=TwoWay}"
                  Margin="0,12,0,0" />
    </Grid>
</UserControl>
