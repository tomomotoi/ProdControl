<UserControl x:Class="ProdControlWPF.Views.NewKnittingInvoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="560"
             d:DesignWidth="960">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource AppSurfaceBrush}"
                BorderBrush="{StaticResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12">
            <StackPanel>
                <WrapPanel Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                        <TextBlock Text="Номер квитанции:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <TextBox Width="170"
                                 Text="{Binding ReceiptNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                        <TextBlock Text="Дата:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <DatePicker Width="140"
                                    SelectedDate="{Binding OperationDate, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                        <TextBlock Text="Рабочий день (мин.):"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <TextBox Width="90"
                                 Text="{Binding Workday, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewTextInput="OnIntegerPreviewTextInput"
                                 DataObject.Pasting="OnIntegerPasting" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                        <TextBlock Text="Артикул:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <ComboBox Width="190"
                                  ItemsSource="{Binding Articuls}"
                                  DisplayMemberPath="ArticulName"
                                  SelectedItem="{Binding SelectedArticul, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                        <TextBlock Text="Количество:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <TextBox Width="100"
                                 Text="{Binding Count, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewTextInput="OnIntegerPreviewTextInput"
                                 DataObject.Pasting="OnIntegerPasting" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                        <TextBlock Text="Деталь:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <ComboBox Width="190"
                                  ItemsSource="{Binding Parts}"
                                  DisplayMemberPath="PartName"
                                  SelectedItem="{Binding SelectedPart, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                        <TextBlock Text="Сотрудник:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <ComboBox Width="220"
                                  ItemsSource="{Binding Employees}"
                                  DisplayMemberPath="EmployeeName"
                                  SelectedItem="{Binding SelectedEmployee, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                        <TextBlock Text="Оборудование:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <ComboBox Width="190"
                                  ItemsSource="{Binding Machines}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedItem="{Binding SelectedMachine, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                        <TextBlock Text="Время выполнения:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <TextBox Width="110"
                                 Text="{Binding ExecutionTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewTextInput="OnDecimalPreviewTextInput"
                                 DataObject.Pasting="OnDecimalPasting" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                        <TextBlock Text="Машин в зоне обсл.:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <TextBox Width="110"
                                 Text="{Binding MachinesInZone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewTextInput="OnIntegerPreviewTextInput"
                                 DataObject.Pasting="OnIntegerPasting" />
                    </StackPanel>
                </WrapPanel>

                <Button Content="Вставить"
                        Command="{Binding InsertCommand}"
                        HorizontalAlignment="Right"
                        MinWidth="100"
                        Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="1"
                  Margin="0,12,0,0"
                  ItemsSource="{Binding Rows}"
                  SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  Background="{StaticResource AppSurfaceBrush}"
                  BorderBrush="{StaticResource AppBorderBrush}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ФИО"
                                    Binding="{Binding EmployeeName}"
                                    Width="Auto" />
                <DataGridTextColumn Header="Номер квитанции"
                                    Binding="{Binding DocumentNumber}"
                                    Width="Auto" />
                <DataGridTextColumn Header="Дата выполнения"
                                    Binding="{Binding DateExecution, StringFormat=d}"
                                    Width="Auto" />
                <DataGridTextColumn Header="Артикул"
                                    Binding="{Binding ArticulName}"
                                    Width="Auto" />
                <DataGridTextColumn Header="Деталь"
                                    Binding="{Binding PartName}"
                                    Width="Auto" />
                <DataGridTextColumn Header="Вяз. машина"
                                    Binding="{Binding MachineName}"
                                    Width="Auto" />
                <DataGridTextColumn Header="Количество"
                                    Binding="{Binding Amount}"
                                    Width="Auto" />
                <DataGridTextColumn Header="Время выполнения"
                                    Binding="{Binding ExecutionTime}"
                                    Width="Auto" />
                <DataGridTextColumn Header="Машин в зоне обсл."
                                    Binding="{Binding MachinesInZone}"
                                    Width="Auto" />
                <DataGridTextColumn Header="Рабочий день"
                                    Binding="{Binding WorkDay}"
                                    Width="Auto" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="Удалить"
                    Command="{Binding DeleteCommand}"
                    Margin="0,0,8,0" />
            <Button Content="Сохранить"
                    Command="{Binding SaveCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
