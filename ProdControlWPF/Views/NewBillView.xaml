<UserControl x:Class="ProdControlWPF.Views.NewBillView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="850">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource AppSurfaceBrush}"
                BorderBrush="{StaticResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="Номер квитанции"
                           VerticalAlignment="Center"
                           Margin="0,6,8,0" />
                <TextBox Grid.Row="0" Grid.Column="1"
                         Text="{Binding LogNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         MinWidth="160"
                         Margin="0,4,12,0" />

                <TextBlock Grid.Row="0" Grid.Column="2"
                           Text="Дата"
                           VerticalAlignment="Center"
                           Margin="0,6,8,0" />
                <DatePicker Grid.Row="0" Grid.Column="3"
                            SelectedDate="{Binding OperationDate, Mode=TwoWay}"
                            Margin="0,4,12,0" />

                <TextBlock Grid.Row="0" Grid.Column="4"
                           Text="Рабочий день"
                           VerticalAlignment="Center"
                           Margin="0,6,8,0" />
                <TextBox Grid.Row="0" Grid.Column="5"
                         x:Name="WorkdayTextBox"
                         Text="{Binding Workday, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Width="80"
                         HorizontalAlignment="Left"
                         Margin="0,4,0,0"
                         PreviewTextInput="OnDigitsOnlyPreviewTextInput"
                         DataObject.Pasting="OnDigitsOnlyPasting" />

                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="Сотрудник"
                           VerticalAlignment="Center"
                           Margin="0,8,8,0" />
                <ComboBox Grid.Row="1" Grid.Column="1"
                          ItemsSource="{Binding Employees}"
                          DisplayMemberPath="EmployeeName"
                          SelectedItem="{Binding SelectedEmployee, Mode=TwoWay}"
                          Margin="0,4,12,0" />

                <TextBlock Grid.Row="1" Grid.Column="2"
                           Text="Артикул"
                           VerticalAlignment="Center"
                           Margin="0,8,8,0" />
                <ComboBox Grid.Row="1" Grid.Column="3"
                          ItemsSource="{Binding Articuls}"
                          DisplayMemberPath="ArticulName"
                          SelectedItem="{Binding SelectedArticul, Mode=TwoWay}"
                          Margin="0,4,12,0" />

                <TextBlock Grid.Row="1" Grid.Column="4"
                           Text="Количество"
                           VerticalAlignment="Center"
                           Margin="0,8,8,0" />
                <TextBox Grid.Row="1" Grid.Column="5"
                         Text="{Binding Count, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsCountEnabled}"
                         Width="80"
                         HorizontalAlignment="Left"
                         Margin="0,4,0,0"
                         PreviewTextInput="OnDigitsOnlyPreviewTextInput"
                         DataObject.Pasting="OnDigitsOnlyPasting" />

                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="Операция"
                           VerticalAlignment="Center"
                           Margin="0,8,8,0" />
                <ComboBox Grid.Row="2" Grid.Column="1"
                          ItemsSource="{Binding Operations}"
                          DisplayMemberPath="OperationName"
                          SelectedItem="{Binding SelectedOperation, Mode=TwoWay}"
                          IsEnabled="{Binding IsOperationEnabled}"
                          Margin="0,4,12,0" />

                <TextBlock Grid.Row="2" Grid.Column="2"
                           Text="Время выполнения"
                           VerticalAlignment="Center"
                           Margin="0,8,8,0" />
                <TextBox Grid.Row="2" Grid.Column="3"
                         Text="{Binding OperationTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsOperationTimeEnabled}"
                         Margin="0,4,12,0"
                         PreviewTextInput="OnDigitsOnlyPreviewTextInput"
                         DataObject.Pasting="OnDigitsOnlyPasting" />

                <CheckBox Grid.Row="2" Grid.Column="4" Grid.ColumnSpan="2"
                          Content="Не нормированная"
                          IsChecked="{Binding IsNonStandard, Mode=TwoWay}"
                          VerticalAlignment="Center"
                          Margin="0,8,0,0" />

                <TextBlock Grid.Row="3" Grid.Column="0"
                           Text="Тип ситуации"
                           VerticalAlignment="Center"
                           Margin="0,8,8,0" />
                <ComboBox Grid.Row="3" Grid.Column="1"
                          ItemsSource="{Binding IdleOperations}"
                          DisplayMemberPath="IdleOperationName"
                          SelectedItem="{Binding SelectedIdleOperation, Mode=TwoWay}"
                          IsEnabled="{Binding IsIdleTypeEnabled}"
                          Margin="0,4,12,0" />

                <Button Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2"
                        Content="Рассчитать время"
                        Command="{Binding CalculateCommand}"
                        IsEnabled="{Binding IsCalculateEnabled}"
                        HorizontalAlignment="Left"
                        Margin="0,8,0,0" />

                <Button Grid.Row="3" Grid.Column="4" Grid.ColumnSpan="2"
                        Content="Вставить"
                        Command="{Binding InsertCommand}"
                        HorizontalAlignment="Left"
                        Margin="0,8,0,0" />
            </Grid>
        </Border>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Rows}"
                  SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  Background="{StaticResource AppSurfaceBrush}"
                  BorderBrush="{StaticResource AppBorderBrush}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="IDСотрудника"
                                    Binding="{Binding EmployeeId}"
                                    IsReadOnly="True"
                                    Visibility="Collapsed" />
                <DataGridTextColumn Header="ФИО"
                                    Binding="{Binding EmployeeName}"
                                    IsReadOnly="True"
                                    Width="*" />
                <DataGridTextColumn Header="Номер квитанции"
                                    Binding="{Binding DocumentNumber}"
                                    IsReadOnly="True"
                                    Width="*" />
                <DataGridTextColumn Header="Дата выполнения"
                                    Binding="{Binding DateExecution, StringFormat=d}"
                                    IsReadOnly="True"
                                    Width="*" />
                <DataGridTextColumn Header="IDArticul"
                                    Binding="{Binding ArticulId}"
                                    IsReadOnly="True"
                                    Visibility="Collapsed" />
                <DataGridTextColumn Header="Артикул"
                                    Binding="{Binding ArticulName}"
                                    IsReadOnly="True"
                                    Width="*" />
                <DataGridTextColumn Header="Время выполнения"
                                    Binding="{Binding ExecutionTime}"
                                    IsReadOnly="True"
                                    Width="*" />
                <DataGridTextColumn Header="Количество"
                                    Binding="{Binding Count}"
                                    IsReadOnly="True"
                                    Width="*" />
                <DataGridTextColumn Header="ОперацияID"
                                    Binding="{Binding OperationId}"
                                    IsReadOnly="True"
                                    Visibility="Collapsed" />
                <DataGridTextColumn Header="Операция"
                                    Binding="{Binding OperationName}"
                                    IsReadOnly="True"
                                    Width="*" />
                <DataGridTextColumn Header="Рабочий день"
                                    Binding="{Binding WorkDay, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="Удалить"
                    Command="{Binding DeleteCommand}"
                    Margin="0,0,8,0" />
            <Button Content="Сохранить"
                    Command="{Binding SaveCommand}"
                    Margin="0,0,8,0" />
            <Button Content="Закрыть"
                    Command="{Binding CloseCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
