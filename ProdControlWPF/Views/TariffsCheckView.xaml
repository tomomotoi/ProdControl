<UserControl x:Class="ProdControlWPF.Views.TariffsCheckView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="360"
             d:DesignWidth="640">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Text="Артикул:" />
                <ComboBox ItemsSource="{Binding Articuls}"
                          DisplayMemberPath="ArticulName"
                          TextSearch.TextPath="ArticulName"
                          SelectedItem="{Binding SelectedArticul, Mode=TwoWay}"
                          IsTextSearchEnabled="True"
                          Margin="0,4,0,0" />
                <Button Content="Выбрать"
                        Command="{Binding SelectArticulCommand}"
                        Margin="0,8,0,0" />
                <CheckBox Content="Выбрать все"
                          IsChecked="{Binding SelectAll, Mode=TwoWay}"
                          Margin="0,12,0,0" />
            </StackPanel>

            <DockPanel Grid.Column="1" Margin="12,0,0,0">
                <TextBlock DockPanel.Dock="Top"
                           Text="Выбранные артикулы:" />
                <StackPanel DockPanel.Dock="Bottom">
                    <Button Content="Удалить из списка"
                            Command="{Binding RemoveArticulCommand}"
                            Margin="0,8,0,0" />
                    <Button Content="Очистить список"
                            Command="{Binding ClearListCommand}"
                            Margin="0,8,0,0" />
                </StackPanel>
                <ListBox ItemsSource="{Binding SelectedArticuls}"
                         DisplayMemberPath="ArticulName"
                         TextSearch.TextPath="ArticulName"
                         SelectedItem="{Binding SelectedListItem, Mode=TwoWay}"
                         SelectionMode="Extended"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         Margin="0,4,0,0" />
            </DockPanel>
        </Grid>

        <Button Grid.Row="1"
                Content="Проверить расценки"
                Command="{Binding CheckTariffsCommand}"
                HorizontalAlignment="Stretch"
                Margin="0,12,0,0" />
    </Grid>
</UserControl>
