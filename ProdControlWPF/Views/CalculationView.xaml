<UserControl x:Class="ProdControlWPF.Views.CalculationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="560"
             d:DesignWidth="920">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DataGrid x:Name="EmployeesGrid"
                  Grid.Row="0"
                  ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserSortColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  SelectionChanged="OnGridSelectionChanged"
                  Background="{StaticResource AppSurfaceBrush}"
                  BorderBrush="{StaticResource AppBorderBrush}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Номер сотрудника"
                                    Binding="{Binding EmployeeId}"
                                    Width="140" />
                <DataGridTextColumn Header="Имя сотрудника"
                                    Binding="{Binding EmployeeName}"
                                    Width="*" />
                <DataGridTextColumn Header="Табельный номер"
                                    Binding="{Binding EmployeeNumber}"
                                    Width="140" />
                <DataGridTextColumn Header="Должность"
                                    Binding="{Binding PositionId}"
                                    Visibility="Collapsed"
                                    Width="100" />
                <DataGridTextColumn Header="Разряд"
                                    Binding="{Binding PositionLevelId}"
                                    Width="80" />
                <DataGridTextColumn Header="Заработная плата"
                                    Binding="{Binding Salary}"
                                    Width="140" />
                <DataGridTextColumn Header="Норма Выроботки"
                                    Binding="{Binding Norm}"
                                    Width="140" />
                <DataGridTextColumn Header="Время выполнения"
                                    Binding="{Binding TimeExecution}"
                                    Width="140" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="1"
                Margin="0,12,0,0"
                Background="{StaticResource AppSurfaceBrush}"
                BorderBrush="{StaticResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0"
                           Orientation="Horizontal"
                           VerticalAlignment="Center">
                    <TextBlock Text="Дата тетради"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <DatePicker SelectedDate="{Binding DateFrom, Mode=TwoWay}"
                                Width="130"
                                Margin="0,0,16,0" />

                    <CheckBox Content="За Период"
                              IsChecked="{Binding IsByPeriod, Mode=TwoWay}"
                              VerticalAlignment="Center"
                              Margin="0,0,16,0" />

                    <TextBlock Text="По"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               Visibility="{Binding IsByPeriod, Converter={StaticResource BoolToVisibility}}" />
                    <DatePicker SelectedDate="{Binding DateTo, Mode=TwoWay}"
                                Width="130"
                                Visibility="{Binding IsByPeriod, Converter={StaticResource BoolToVisibility}}" />
                </WrapPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="Выгрузить"
                            Command="{Binding ExportCommand}"
                            Margin="0,0,8,0" />
                    <Button Content="Рассчитать"
                            Command="{Binding CalculateCommand}"
                            Margin="0,0,8,0" />
                    <Button Content="Закрыть"
                            Command="{Binding CloseCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
