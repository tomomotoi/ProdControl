<UserControl x:Class="ProdControlWPF.Views.KnittingRoutingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="620"
             d:DesignWidth="1000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource AppSurfaceBrush}"
                BorderBrush="{StaticResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12">
            <StackPanel>
                <WrapPanel Orientation="Horizontal">
                    <TextBlock Text="Артикул"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{Binding Articuls}"
                              DisplayMemberPath="ArticulName"
                              SelectedItem="{Binding SelectedArticul, Mode=TwoWay}"
                              Width="220"
                              Margin="0,0,8,0" />
                    <Button Content="Найти"
                            Command="{Binding SearchCommand}" />
                </WrapPanel>

                <WrapPanel Orientation="Horizontal"
                           Margin="0,10,0,0">
                    <TextBlock Text="Деталь:"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{Binding Parts}"
                              DisplayMemberPath="PartName"
                              SelectedItem="{Binding SelectedPart, Mode=TwoWay}"
                              Width="160"
                              Margin="0,0,16,0" />

                    <TextBlock Text="Оборудование:"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{Binding Machines}"
                              DisplayMemberPath="DisplayName"
                              SelectedItem="{Binding SelectedMachine, Mode=TwoWay}"
                              Width="200"
                              Margin="0,0,16,0" />

                    <TextBlock Text="М:"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{Binding ModelPartAmounts}"
                              SelectedItem="{Binding SelectedModelPartAmount, Mode=TwoWay}"
                              Width="60"
                              Margin="0,0,16,0" />

                    <TextBlock Text="П:"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{Binding MachineCarriageAmounts}"
                              SelectedItem="{Binding SelectedMachineCarriageAmount, Mode=TwoWay}"
                              Width="60"
                              Margin="0,0,16,0" />

                    <TextBlock Text="Коэфф. уч. доп. затр.:"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{Binding Coefficients}"
                              DisplayMemberPath="Display"
                              SelectedItem="{Binding SelectedCoefficient1, Mode=TwoWay}"
                              Width="80"
                              Margin="0,0,4,0" />
                    <ComboBox ItemsSource="{Binding Coefficients}"
                              DisplayMemberPath="Display"
                              SelectedItem="{Binding SelectedCoefficient2, Mode=TwoWay}"
                              Width="80" />
                </WrapPanel>

                <WrapPanel Orientation="Horizontal"
                           Margin="0,10,0,0">
                    <TextBlock Text="Средн. зн.:"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <TextBox x:Name="AvgValueTextBox"
                             Text="{Binding AvgValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Width="90"
                             Margin="0,0,16,0"
                             PreviewTextInput="OnDecimalPreviewTextInput"
                             DataObject.Pasting="OnDecimalPasting" />

                    <TextBlock Text="С коэфф.:"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <TextBox Text="{Binding WithCoefficient, Mode=OneWay}"
                             IsReadOnly="True"
                             Width="90"
                             Margin="0,0,16,0"
                             Background="{StaticResource AppBackgroundBrush}" />

                    <TextBlock Text="С компл.:"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <TextBox Text="{Binding WithKit, Mode=OneWay}"
                             IsReadOnly="True"
                             Width="90"
                             Background="{StaticResource AppBackgroundBrush}" />
                </WrapPanel>

                <WrapPanel Orientation="Horizontal"
                           Margin="0,10,0,0">
                    <TextBlock Text="Итого:"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <TextBox Text="{Binding Total, Mode=OneWay}"
                             IsReadOnly="True"
                             Width="90"
                             Margin="0,0,24,0"
                             Background="{StaticResource AppBackgroundBrush}" />

                    <TextBlock Text="Норма:"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <TextBox Text="{Binding Norm, Mode=OneWay}"
                             IsReadOnly="True"
                             Width="90"
                             Background="{StaticResource AppBackgroundBrush}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="1"
                  Margin="0,12,0,0"
                  ItemsSource="{Binding Rows}"
                  SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  Background="{StaticResource AppSurfaceBrush}"
                  BorderBrush="{StaticResource AppBorderBrush}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Деталь"
                                    Binding="{Binding PartName}"
                                    Width="*" />
                <DataGridTextColumn Header="Оборудование"
                                    Binding="{Binding MachineName}"
                                    Width="*" />
                <DataGridTextColumn Header="М"
                                    Binding="{Binding ModelPartAmount}"
                                    Width="50" />
                <DataGridTextColumn Header="П"
                                    Binding="{Binding MachineCarriageAmount}"
                                    Width="50" />
                <DataGridTextColumn Header="Коэф. доп. 1"
                                    Binding="{Binding Coefficient1}"
                                    Width="100" />
                <DataGridTextColumn Header="Коэф. доп. 2"
                                    Binding="{Binding Coefficient2}"
                                    Width="100" />
                <DataGridTextColumn Header="Средн. зн."
                                    Binding="{Binding AvgValue}"
                                    Width="90" />
                <DataGridTextColumn Header="С коэфф."
                                    Binding="{Binding WithCoefficient}"
                                    Width="90" />
                <DataGridTextColumn Header="С компл."
                                    Binding="{Binding WithKit}"
                                    Width="90" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2"
              Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal">
                <Button Content="Добавить"
                        Command="{Binding AddCommand}"
                        Margin="0,0,8,0" />
                <Button Content="Удалить"
                        Command="{Binding DeleteCommand}"
                        Margin="0,0,8,0" />
                <Button Content="Сохранить"
                        Command="{Binding SaveCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
