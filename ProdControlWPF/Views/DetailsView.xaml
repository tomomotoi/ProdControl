<UserControl x:Class="ProdControlWPF.Views.DetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="420"
             d:DesignWidth="860">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="330" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Grid.Column="0"
                   Text="Список деталей" />

        <Border Grid.Row="1"
                Grid.Column="0"
                Background="{StaticResource AppSurfaceBrush}"
                BorderBrush="{StaticResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                Margin="0,6,0,0">
            <DataGrid x:Name="DetailsGrid"
                      AutomationProperties.Name="Список деталей"
                      ItemsSource="{Binding Details}"
                      SelectedItem="{Binding SelectedDetail, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      Background="{StaticResource AppSurfaceBrush}"
                      BorderBrush="{StaticResource AppBorderBrush}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID"
                                        Binding="{Binding Id}"
                                        Width="60"
                                        IsReadOnly="True" />
                    <DataGridTextColumn Header="Наименование детали"
                                        Binding="{Binding Name}"
                                        Width="*"
                                        IsReadOnly="True" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <GroupBox Grid.Row="0"
                  Grid.RowSpan="2"
                  Grid.Column="1"
                  Header="Свойства детали"
                  Padding="12"
                  Margin="12,0,0,0">
            <StackPanel>
                <TextBlock Text="Наименование детали:" />
                <TextBox Text="{Binding PartName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Наименование детали"
                         Height="120"
                         Margin="0,4,0,0"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" />
            </StackPanel>
        </GroupBox>

        <Grid Grid.Row="2"
              Grid.Column="0"
              Grid.ColumnSpan="2"
              Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="Добавить"
                    Command="{Binding AddCommand}"
                    Margin="0,0,6,0" />
            <Button Grid.Column="1"
                    Content="Сохранить изменения"
                    Command="{Binding SaveCommand}"
                    Margin="0,0,6,0" />
            <Button Grid.Column="2"
                    Content="Удалить"
                    Command="{Binding DeleteCommand}"
                    Margin="0,0,6,0" />
            <Button Grid.Column="3"
                    Content="Очистить поля"
                    Command="{Binding ClearCommand}" />
        </Grid>
    </Grid>
</UserControl>
