<UserControl x:Class="ProdControlWPF.Views.EmployeesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="560"
             d:DesignWidth="920">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource AppSurfaceBrush}"
                BorderBrush="{StaticResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12">
            <StackPanel>
                <WrapPanel Orientation="Horizontal">
                    <TextBlock Text="Фильтр:"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{Binding FilterOptions}"
                              SelectedIndex="{Binding SelectedFilterIndex, Mode=TwoWay}"
                              Width="180" />
                </WrapPanel>

                <DockPanel Margin="0,10,0,0">
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Content="Найти всех"
                                Command="{Binding SearchAllCommand}"
                                Margin="0,0,8,0" />
                        <Button Content="Найти"
                                Command="{Binding SearchCommand}" />
                    </StackPanel>

                    <WrapPanel Orientation="Horizontal">
                        <TextBlock Text="ФИО:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   Visibility="{Binding IsNameFilterVisible, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="№ сотрудника:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   Visibility="{Binding IsNumberFilterVisible, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="Должность:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   Visibility="{Binding IsPositionFilterVisible, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="Разряд:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   Visibility="{Binding IsLevelFilterVisible, Converter={StaticResource BoolToVisibility}}" />

                        <TextBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Width="180"
                                 Margin="0,0,16,0"
                                 Visibility="{Binding IsSearchTextBoxVisible, Converter={StaticResource BoolToVisibility}}" />

                        <ComboBox ItemsSource="{Binding Positions}"
                                  DisplayMemberPath="PositionName"
                                  SelectedItem="{Binding SelectedPosition, Mode=TwoWay}"
                                  Width="180"
                                  Visibility="{Binding IsPositionFilterVisible, Converter={StaticResource BoolToVisibility}}" />
                    </WrapPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <DataGrid x:Name="EmployeeGrid"
                  Grid.Row="1"
                  Margin="0,12,0,0"
                  ItemsSource="{Binding Employees}"
                  SelectedItem="{Binding SelectedEmployee, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  IsReadOnly="{Binding IsGridReadOnly}"
                  Background="{StaticResource AppSurfaceBrush}"
                  BorderBrush="{StaticResource AppBorderBrush}"
                  PreviewTextInput="OnGridPreviewTextInput"
                  DataObject.Pasting="OnGridPasting">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ФИО"
                                    Binding="{Binding EmployeeName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                    Width="*" />
                <DataGridTextColumn Header="№ сотрудника"
                                    Binding="{Binding EmployeeNumber, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                    Width="*" />
                <DataGridTemplateColumn Header="Должность"
                                        Width="*"
                                        CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding PositionName}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding DataContext.Positions, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                      DisplayMemberPath="PositionName"
                                      SelectedValuePath="PositionId"
                                      SelectedValue="{Binding PositionId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Разряд должности"
                                    Binding="{Binding PositionLevel, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                    CanUserSort="False"
                                    Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2"
              Margin="0,12,0,0">
            <CheckBox Content="Режим редактирования"
                      IsChecked="{Binding IsEditingMode, Mode=TwoWay}"
                      VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Сохранить"
                        Command="{Binding SaveCommand}"
                        IsEnabled="{Binding IsEditingMode}"
                        Margin="0,0,8,0" />
                <Button Content="Добавить"
                        Command="{Binding AddCommand}"
                        IsEnabled="{Binding IsEditingMode}"
                        Margin="0,0,8,0" />
                <Button Content="Удалить"
                        Command="{Binding DeleteCommand}"
                        IsEnabled="{Binding IsEditingMode}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
